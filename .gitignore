# ============================================================================
# CMCMIS_SIMPLIFIED  —  Project-wide Git ignore (root)
# ----------------------------------------------------------------------------
# Catch-all rules that apply to every folder. Sub-projects (BE, FE,
# DATABASE/phase3, TECH_DOCX) carry their own narrower .gitignore files
# for tool-specific patterns.
# ============================================================================

# ── Secrets — NEVER commit ─────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.p12
secrets/

# ── Node ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.yarn/

# ── Python (build scripts in TECH_DOCX, future tooling) ───────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Build / dist output ────────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo

# ── Coverage / test artefacts ──────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Logs ───────────────────────────────────────────────────────────────────
logs/
*.log
pids/
*.pid
*.seed

# ── Editor / OS cruft ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~
.history/

# ── Temporary / backup files from word processors and exports ─────────────
~$*.docx
~$*.xlsx
~$*.pptx
*.bak
*.tmp
*.temp

# ── Database dumps / local-only SQL exports ────────────────────────────────
*.sql.gz
*.dump
dump.rdb

# ── OS-level archive / installer leftovers ─────────────────────────────────
*.zip
*.tar
*.tar.gz
*.7z
*.rar
!SOFTWARE\ CODE/DATABASE/phase3/migrations/*.sql

# ── Claude Code / agent runtime ────────────────────────────────────────────
.claude/cache/
.claude/tmp/
