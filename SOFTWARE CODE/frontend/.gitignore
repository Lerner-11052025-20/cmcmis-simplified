# ============================================================================
# CMCMIS Frontend  —  Git ignore rules
# ----------------------------------------------------------------------------
# Mirrors the backend list; tighter coverage isn't useful for a Vite app.
# ============================================================================

# Build output
dist/
dist-ssr/

# Vite cache + tooling
.vite/
*.local

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files (never commit secrets)
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
