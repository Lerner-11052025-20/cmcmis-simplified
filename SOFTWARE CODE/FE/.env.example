# ============================================================================
# CMCMIS Frontend  —  Environment Configuration (template)
# ----------------------------------------------------------------------------
# Vite only injects vars prefixed with VITE_ into the bundle, so anything
# without that prefix is a server-side build-tool var.
# Copy this file to `.env` and edit as needed; .env is git-ignored.
# ============================================================================

# Where the backend lives. In dev the proxy in vite.config.js forwards
# /api → http://localhost:3000, so this var is informational. In prod
# (Phase 10) Nginx will serve FE + BE under the same hostname, and the
# axios client will keep its baseURL='/api/v1'.
VITE_API_BASE_URL=/api/v1
