# ════════════════════════════════════════════════════════════════════
# CMCMIS_SIMPLIFIED — Phase 3 Migration Runner Environment
# Copy this file to .env and fill in real values for your environment.
# ════════════════════════════════════════════════════════════════════

# ─── Database Connection ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cmcmis_redev

# ─── Environment Mode ──────────────────────────────────────────────
#  development | production
#  Drives the default bcrypt rounds (10 in dev, 12 in prod) unless
#  BCRYPT_ROUNDS is set explicitly below.
NODE_ENV=development

# ─── Bcrypt Cost Factor ────────────────────────────────────────────
#  10 = dev/test (~80ms hash on commodity CPU)
#  12 = production (~250ms hash; required for defence-grade)
#  Override here if needed:
BCRYPT_ROUNDS=10

# ─── Super Admin Bootstrap (locked D11) ────────────────────────────
#  Comma-separated employee_ids that will be seeded as SUPER_ADMIN.
#  Each MUST match the locked password regex: ^[A-Z]{2}[0-9]{5}$
#  Each will get its own employee_id as the initial password.
SUPER_ADMIN_EMPLOYEE_IDS=SA79900,AC77777

# ─── Debug Output ──────────────────────────────────────────────────
#  Uncomment to print stack traces on errors.
# DEBUG=1
